# Local development: leave browser API overrides empty to use Vite's /api proxy.
# Server-only proxy target. Restart Vite after changing these values.
ADMIN_PROXY_TARGET=http://127.0.0.1:8787
VITE_PRIVATE_API_URL=
VITE_API_BASE_URL=
# For a remote private API, set ADMIN_PROXY_TARGET to its actual Tailscale URL.
# HTTPS requires a TLS listener/reverse proxy; the Node server itself serves HTTP.
# Built admin defaults to http://localhost:8787. For HTTPS-hosted admin, explicitly
# set VITE_PRIVATE_API_URL to your private HTTPS API before building.
# Never put secrets in VITE_* variables.
VITE_ONLINE_API_URL=https://zul-portfolio-api.vercel.app
