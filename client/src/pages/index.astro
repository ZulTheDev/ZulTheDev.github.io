---
import fs from 'node:fs/promises';
import PortfolioApp from '../App.jsx';
import '../style.css';
import '../responsive.css';

const contentPath = new URL('../../public/content.json', import.meta.url);
const initialContent = JSON.parse(await fs.readFile(contentPath, 'utf8'));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e0b13" />
    <meta name="description" content="Zulfaqar Jamal — cybersecurity, software development, projects, research, certifications and work experience." />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="dns-prefetch" href="//drive.google.com" />
    <title>Zulfaqar Jamal</title>
  </head>
  <body>
    <PortfolioApp initialContent={initialContent} client:load />
  </body>
</html>
