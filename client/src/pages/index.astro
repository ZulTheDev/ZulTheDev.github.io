---
import fs from 'node:fs';
import path from 'node:path';
import PortfolioApp from '../App.jsx';
import '../style.css';
import '../responsive.css';

const projectRoot = process.env.INIT_CWD || process.cwd();
const contentPath = path.resolve(projectRoot, 'public/content.json');
const initialContent = JSON.parse(fs.readFileSync(contentPath, 'utf8'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e0b13" />
    <meta name="description" content="Zulfaqar Jamal — security-minded builder, projects, research, experience and certifications." />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="dns-prefetch" href="//drive.google.com" />
    <title>Zulfaqar Jamal</title>
  </head>
  <body>
    <PortfolioApp initialContent={initialContent} client:load />
  </body>
</html>
