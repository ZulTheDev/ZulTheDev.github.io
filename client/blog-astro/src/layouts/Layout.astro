---
import '../styles/global.css';
import NavigationDock from '../components/NavigationDock.astro';
import MentorBanner from '../components/MentorBanner.jsx';

const {
  title = "zul's digital archive ✨",
  description = 'Cybersecurity, engineering experiments, scripts, CTF writeups and cozy technical rabbit holes.',
  preloadImage = '',
  showMentorBanner = false,
  navItems = [
    { href: '/', label: 'Home', icon: '⌂' },
    { href: '/blog/', label: 'Blog', icon: '✦' },
    { href: '/ctf_blog/', label: 'CTF', icon: '⚑' },
    { href: '/port_resume/', label: 'Resume', icon: '▤' },
  ],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="theme-color" content="#1a1625" />
    <meta name="description" content={description} />

    {preloadImage && (
      <link
        rel="preload"
        href={preloadImage}
        as="image"
        type="image/webp"
        fetchpriority="high"
      />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <div
      class="ambient-glow ambient-glow--pink"
      aria-hidden="true"
    ></div>
    <div
      class="ambient-glow ambient-glow--blue"
      aria-hidden="true"
    ></div>

    <div class="site-corner-brand" aria-label="Site identity">
      <a href="/" aria-label="Zul Jamal portfolio home">
        ZUL<span>/</span>JAMAL
      </a>
      <small>digital archive ✨</small>
    </div>

    {showMentorBanner && (
      <div class="layout-mentor-slot">
        <MentorBanner client:load />
      </div>
    )}

    <div id="main-content">
      <slot />
    </div>

    <NavigationDock items={navItems} />

    <footer class="site-footer">
      <span>
        built with astro, curiosity, and a little pink magic ♡
      </span>
      <div>
        <a href="https://github.com/ZulTheDev" target="_blank" rel="noreferrer">
          github ↗
        </a>
        <a href="/blog/">notes ↗</a>
      </div>
    </footer>
  </body>
</html>
