PORT=8787
CLIENT_ORIGIN=https://zulthedev.github.io,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Local admin API: authentication and roles are intentionally disabled because this server is local-only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Separate Zulfaqar-only AI knowledge folder. Do not point this at another portfolio.
GOOGLE_DRIVE_CHATBOT_FOLDER_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TAILSCALE_AI_URL=
TAILSCALE_AI_SHARED_SECRET=

# Shared Redis Cloud database for durable public comments, Ko-fi events, and buy-first access.
# Keep this secret and never commit it.
REDIS_URL=
# Set true only for local development when you explicitly accept disk-based comment fallback.
ALLOW_LOCAL_COMMENT_FALLBACK=false

# Ko-fi webhook verification token from Ko-fi > Settings > API/Webhooks.
# Keep this secret and never commit it.
KO_FI_VERIFICATION_TOKEN=
# Lifetime of a verified buy-first access token in seconds (default: one year).
BUY_FIRST_ACCESS_TTL_SECONDS=31536000

# CTF writeups / Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Judge0 code runner
JUDGE0_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_USER=

# GitHub App service account used by the local admin to publish CTF JSON to GitHub.
# Keep the private key local and never commit the real .env file.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=ZulTheDev
GITHUB_REPO=ZulTheDev.github.io
GITHUB_BRANCH=main
GITHUB_APP_AUTO_PUSH=false

# Persistent public Judge0 abuse protection (online-comments/Vercel)
RATE_LIMIT_HASH_SECRET=
